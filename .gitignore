# Staged third-party cores. Fetched by scripts/fetch-cores.ps1 and verified
# against published checksums, so they are build output rather than source.
/cores/

# Optional geo assets. Not in the repository because they are large and only the
# ads rule needs them.
/geo/

# Build output.
/dist/
/stage/
*.exe
*.zip
*.log

# Generated by the selftest. Written next to the executable so a failing run can
# be diagnosed from its own artefacts.
/generated-xray.json
/access.log
